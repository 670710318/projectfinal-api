# คัดลอกเป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ไม่ถูก commit)
# บน Render ให้ใส่ค่าเหล่านี้ที่ Environment แทน ไม่ต้องใช้ไฟล์

# Supabase > Project Settings > Database > Connection string > "Session pooler" (พอร์ต 5432)
DATABASE_URL=postgresql://postgres.xxxxxxxx:รหัสผ่าน@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# สุ่มเองอย่างน้อย 32 ตัวอักษร เช่น  openssl rand -hex 32
JWT_SECRET=

# โดเมนหน้าเว็บที่อนุญาต คั่นด้วย , (ไม่ต้องมี / ท้าย)
ALLOWED_ORIGINS=http://localhost:3000,https://dormhub-ชื่อทีม.vercel.app

# Render ตั้งให้เอง ตอนรันในเครื่องไม่ใส่ก็ได้ (ค่าเริ่มต้น 8080)
# PORT=8080
